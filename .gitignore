# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Rstudio
.Rhistory

# Production
.html

# Python
__pycache__/
*.pyc

# Generated per-run override config (written by grading-readiness-audit/scripts/run_audit.py)
grading-readiness-audit/config/audit-config.override.yaml

# Ad-hoc rubric-validation runs (informational scratch results)
rubric-validation/outputs/adhoc-*/

# Ad-hoc reason-code-validation runs (informational scratch results)
reason-code-validation/outputs/adhoc-*/

# Data files: never commit CSV/JSON that hold actual data (gameplay logs,
# classroom exports, audit outputs, per-student reports). Code here is Python
# and configuration is YAML; the few JSON configuration files are allow-listed below.
*.csv
*.tsv
*.json
*.jsonl
*.ndjson

# Allow-list: JSON that is configuration, not data
!.claude/settings.json
!package.json
!package-lock.json
!tsconfig*.json
